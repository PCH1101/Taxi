# ================================================================================
# Taxi Lakehouse Pipeline — Environment Variables (PySpark + Delta Lake + MinIO + Airflow + Trino)
# Copy this file to .env and adjust the configuration values as needed.
# ================================================================================

# ── MinIO Object Storage ───────────────────────────────────────────────────────
MINIO_VERSION=RELEASE.2024-11-07T00-52-20Z
MINIO_MC_VERSION=latest
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_secure_minio_root_password
MINIO_PIPELINE_ACCESS_KEY=your_pipeline_access_key
MINIO_PIPELINE_SECRET_KEY=your_pipeline_secret_key
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001

# ── 3 Storage Tiers / Buckets ──────────────────────────────────────────────────
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# ── Spark & Delta Lake Configuration ──────────────────────────────────────────
SPARK_APP_NAME=TaxiLakehouse
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g

# ── Trino Query Engine ────────────────────────────────────────────────────────
TRINO_VERSION=465
TRINO_PORT=8080

# ── Apache Airflow (Orchestrator) ─────────────────────────────────────────────
AIRFLOW_VERSION=2.10.3
AIRFLOW_PORT=8090
AIRFLOW_ADMIN_PASSWORD=your_secure_airflow_admin_password
# Generate Fernet key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_SECRET_KEY=your_airflow_webserver_secret_key

# ── PostgreSQL (Airflow Metadata & Pipeline Audit Database) ───────────────────
POSTGRES_VERSION=16-alpine
POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=airflow
POSTGRES_PORT=5432
POSTGRES_HOST=postgres
